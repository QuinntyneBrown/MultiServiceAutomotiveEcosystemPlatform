{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "tenant-route": {
        "ClusterId": "tenant-cluster",
        "Match": {
          "Path": "/api/tenants/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/tenants/{**catch-all}" }
        ]
      },
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/customers/{**catch-all}" }
        ]
      },
      "professional-route": {
        "ClusterId": "professional-cluster",
        "Match": {
          "Path": "/api/professionals/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/professionals/{**catch-all}" }
        ]
      },
      "specialties-route": {
        "ClusterId": "professional-cluster",
        "Match": {
          "Path": "/api/specialties/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/specialties/{**catch-all}" }
        ]
      },
      "referral-route": {
        "ClusterId": "referral-cluster",
        "Match": {
          "Path": "/api/referrals/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/referrals/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "tenant-cluster": {
        "Destinations": {
          "tenant-api": {
            "Address": "http://tenant-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "customer-cluster": {
        "Destinations": {
          "customer-api": {
            "Address": "http://customer-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "professional-cluster": {
        "Destinations": {
          "professional-api": {
            "Address": "http://professional-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "referral-cluster": {
        "Destinations": {
          "referral-api": {
            "Address": "http://referral-api"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  }
}
